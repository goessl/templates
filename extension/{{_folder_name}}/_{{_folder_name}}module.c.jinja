#define PY_SSIZE_T_CLEAN
#include <Python.h>



PyDoc_STRVAR(foo_doc,
"Return the sum of `a` and `b`.\n\
\n\
$$\n\
    a + b\n\
$$\n\
\n\
C implementation.\n\
");

static PyObject*
foo(PyObject* self, PyObject* args, PyObject* kwargs)
{
    PyObject* a;
    PyObject* b;
    static const char* kwlist[] = {"a", "b", NULL};
    if(!PyArg_ParseTupleAndKeywords(args, kwargs, "OO:foo", kwlist, &a, &b)) {
        return NULL;
    }
    
    return PyNumber_Add(a, b);
}



PyDoc_STRVAR({{_folder_name}}_doc,
"{{_folder_name}} C implementation.");

static PyMethodDef {{_folder_name}}_methods[] = {
    {"foo", foo, METH_VARARGS|METH_KEYWORDS, foo_doc},
    {NULL, NULL, 0, NULL} //sentinel
};

static PyModuleDef {{_folder_name}}module = {
    .m_base = PyModuleDef_HEAD_INIT,
    .m_name = "{{_folder_name}}._{{_folder_name}}",
    .m_doc  = {{_folder_name}}_doc,
    .m_size = 0,
    .m_methods = {{_folder_name}}_methods,
    .m_slots = NULL,
    .m_traverse = NULL,
    .m_clear = NULL,
    .m_free = NULL
};

PyMODINIT_FUNC
PyInit__{{_folder_name}}(void)
{
    return PyModuleDef_Init(&{{_folder_name}}module);
}
