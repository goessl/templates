/* Class */

//class Ooo:
//    def __init(self, a, b):
//        self.a, self.b = a, b

typedef struct {
    PyObject_HEAD
    PyObject* a;
    PyObject* b;
} OooObject;

#define OooObject_CAST(op)  ((OooObject*)(op))
// TODO: full support for type-checking was added in 3.14 (Py_tp_token)
// #define Ooo_Check(v)      Py_IS_TYPE(v, Ooo_Type)

PyDoc_STRVAR(Ooo_doc, "Ooo. C implementation.");

static int
Ooo_traverse(PyObject* op, visitproc visit, void* arg)
{
    OooObject* self = OooObject_CAST(op);
    Py_VISIT(Py_TYPE(self));
    Py_VISIT(self->a);
    Py_VISIT(self->b);
    return 0;
}

static int
Ooo_clear(PyObject* op)
{
    OooObject* self = OooObject_CAST(op);
    Py_CLEAR(self->a);
    Py_CLEAR(self->b);
    return 0;
}

static void
Ooo_dealloc(PyObject* op)
{
    OooObject* self = OooObject_CAST(op);
    PyTypeObject* tp = Py_TYPE(self);
    PyObject_GC_UnTrack(self);
    (void)Ooo_clear(self);
    tp->tp_free(self);
    Py_DECREF(tp);
}

//https://docs.python.org/3/c-api/structures.html#c.PyMemberDef
static PyMemberDef Ooo_members[] = {
    {"a", Py_T_OBJECT_EX, offsetof(OooObject, a), 0, NULL},
    {"b", Py_T_OBJECT_EX, offsetof(OooObject, b), 0, NULL},
    {NULL}  /* sentinel */
};

static int
Ooo_init(PyObject* op, PyObject* args, PyObject* kwds)
{
    OooObject* self = OooObject_CAST(op);
    PyObject* a = NULL;
    PyObject* b = NULL;
    static const char* kwlist[] = {"a", "b", NULL};
    if(!PyArg_ParseTupleAndKeywords(args, kwds, "OO", kwlist, &a, &b)) {
        return -1;
    }
    Py_XSETREF(self->a, Py_NewRef(a));
    Py_XSETREF(self->b, Py_NewRef(b));
    
    return 0;
}

static PyObject*
Ooo_new(PyTypeObject* type, PyObject* args, PyObject* kwds)
{
    OooObject* self = OooObject_CAST(type->tp_alloc(type, 0));
    if(self != NULL) {
        self->a = NULL;
        self->b = NULL;
    }
    return (PyObject*)self;
}

