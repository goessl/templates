/* Function */

PyDoc_STRVAR(foo_doc, "Add two objects. C implementation.");

static PyObject*
foo(PyObject* self, PyObject* args, PyObject* kwargs)
{
    PyObject* a;
    PyObject* b;
    static const char* kwlist[] = {"a", "b", NULL};
    if(!PyArg_ParseTupleAndKeywords(args, kwargs, "OO", kwlist, &a, &b)) {
        return NULL;
    }
    
    return PyNumber_Add(a, b);
}



/* Module */

PyDoc_STRVAR({{_folder_name}}_doc,
"{{_folder_name}} C implementation.");

static PyMethodDef {{_folder_name}}_methods[] = {
    {"foo", foo, METH_VARARGS|METH_KEYWORDS, foo_doc},
    {NULL, NULL, 0, NULL} //sentinel
};

static int
{{_folder_name}}_exec(PyObject* module)
{
    {{_folder_name}}_state* state = PyModule_GetState(module);
    
    state->Ooo_type = PyType_FromModuleAndSpec(module, &Ooo_spec, NULL);
    if(state->Ooo_type == NULL) {
        return -1;
    }
    if(PyModule_AddType(module, state->Ooo_type) < 0) {
        return -1;
    }
    
    return 0;
}

static PyModuleDef_Slot {{_folder_name}}_slots[] = {
    {Py_mod_exec, {{_folder_name}}_exec},
    {0, NULL}
};

static int
{{_folder_name}}_traverse(PyObject* mod, visitproc visit, void* arg)
{
    {{_folder_name}}_state* state = ({{_folder_name}}_state*)PyModule_GetState(mod);
    Py_VISIT(state->Ooo_type);
    return 0;
}

static int
{{_folder_name}}_clear(PyObject* mod)
{
    {{_folder_name}}_state* state = ({{_folder_name}}_state*)PyModule_GetState(mod);
    Py_CLEAR(state->Ooo_type);
    return 0;
}

static void
{{_folder_name}}_free(void* mod)
{
    (void){{_folder_name}}_clear((PyObject*)mod);
}

